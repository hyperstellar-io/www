{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "hyperstellartechnology.in" }],
      "destination": "https://www.hyperstellartechnology.in/:path",
      "permanent": true
    }
  ]
}
